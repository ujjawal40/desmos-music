{
  "title": "Arrakis (Dune-style, original)",
  "description": "Original piece in the style of a desert-epic score: a beating low D drone, a throat-sung Phrygian chant (D–Eb), war drums, a sliding vocal wail and a sandworm riser. Time unit = 1 beat.",
  "base": "D4",
  "bpm": 66,
  "window": 8,
  "sections": [
    {"name": "dawn", "start": 0, "end": 16},
    {"name": "storm", "start": 16, "end": 48},
    {"name": "worm", "start": 48, "end": 64},
    {"name": "settle", "start": 64, "end": 72}
  ],
  "voices": [
    {
      "name": "drone",
      "latex": "-2",
      "timbre": "reed",
      "detune": 9,
      "dynamics": [[0, 0], [8, 1], [64, 1], [72, 0]],
      "gain": 0.25,
      "color": "#8a5a1c"
    },
    {
      "name": "fifth",
      "comment": "Open fifth (A2) above the drone once the drums arrive.",
      "latex": "-\\frac{17}{12}",
      "in": ["storm", "worm"],
      "timbre": "hollow",
      "gain": 0.1,
      "color": "#a8742a"
    },
    {
      "name": "chant",
      "comment": "Low throat-chant figure in D Phrygian, sliding between notes.",
