      "seq": "D5:2 Eb5:1 D5:1 | C5:2 Bb4:1 A4:1 | Bb4:3 A4:1 | A4:4 | F5:2 Eb5:1 D5:1 | Eb5:3 D5:1 | C5:2 D5:2 | D5:4",
      "offset": 16,
      "in": ["storm", "worm"],
