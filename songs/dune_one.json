{
  "title": "Dune — part one (after @measure_plan)",
  "description": "Recreation of the first section of the viral 'Dune soundtrack on a graphing calculator' clip. Pitch is in octaves relative to base_hz, so 1/12 = one semitone.",
  "base_hz": 220,
  "time_scale": 1.0,
  "window": 8,
  "helpers": {
    "h": "\\operatorname{mod}\\left(\\frac{x}{2},1\\right)",
    "w": "\\operatorname{mod}\\left(\\frac{x}{8},1\\right)"
  },
  "voices": [
    {
      "name": "kick",
      "latex": "\\left\\{h\\left(x\\right)<0.3:1.5e^{-14h\\left(x\\right)}-2.1\\right\\}",
      "gain": 0.9,
      "color": "#f5a623"
    },
    {
      "name": "bend",
      "latex": "-1+\\frac{3w\\left(x\\right)^{2}}{12}",
      "gain": 0.35,
      "color": "#f5a623"
    },
    {
      "name": "fall",
      "latex": "\\frac{7}{12}-\\frac{w\\left(x\\right)}{12}",
      "gain": 0.25,
      "color": "#f5a623"
    },
    {
      "name": "drone",
      "latex": "-1",
      "gain": 0.3,
      "color": "#c47f1a"
    },
    {
      "name": "high",
      "latex": "\\left\\{w\\left(x\\right)>0.5:\\frac{19}{12}-\\frac{w\\left(x\\right)-0.5}{6}\\right\\}",
      "gain": 0.2,
      "color": "#ffd27a"
    },
    {
      "name": "lead",
      "comment": "Example of the note-sequence voice type: [start, duration, semitones]. Not in the original clip.",
      "loop": 8,
      "notes": [[0, 2, 0], [2, 1, 3], [3, 1, 5], [4, 3, 7], [7, 1, 5]],
      "gain": 0.25,
      "muted": true,
      "color": "#e8e0c8"
    }
  ]
}
