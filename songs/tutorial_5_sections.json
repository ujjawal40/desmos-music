{
  "title": "Tutorial 5 — sections and dynamics",
  "description": "Sections name stretches of time; 'in' picks where a voice plays; 'dynamics' draws a volume line. The playhead loops at the end.",
  "base": "D4",
  "key": "D3 phrygian",
  "bpm": 70,
  "sections": [
    {"name": "quiet", "start": 0, "end": 8},
    {"name": "loud", "start": 8, "end": 24},
    {"name": "fade", "start": 24, "end": 32}
  ],
  "voices": [
    {"name": "drone", "latex": "-2", "timbre": "reed", "dynamics": [[0, 0.3], [8, 1], [24, 1], [32, 0]],
     "gain": 0.3, "color": "#8a5a1c"},
    {"name": "chant", "seq": "^1:3 ^b2 ^1:2 ^7,:2", "in": ["loud", "fade"], "offset": 8, "env": "voice",
     "timbre": "brass", "glide": 0.25, "gain": 0.25, "color": "#c47f1a"},
    {"name": "drums", "hits": "X . . x X . x .", "step": 0.5, "drum": "taiko", "in": "loud",
     "gain": 0.6, "color": "#f5a623"}
  ]
}
